# ============================================================
# PM Agent configuration
# ============================================================

# Data source: jira (default) or redmine
PM_SOURCE=jira

# Jira (required when PM_SOURCE=jira)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=replace_me
JIRA_PROJECT_KEY=DEV
JIRA_BOARD_ID=1

# Redmine (required when PM_SOURCE=redmine)
REDMINE_BASE_URL=https://redmine.example.com
REDMINE_API_KEY=replace_me
# Numeric project ID, as required by Redmine's issues REST filter.
REDMINE_PROJECT_ID=1

# AI provider fallback chain
AI_PROVIDER_ORDER=groq,gemini,openrouter
AI_REQUEST_TIMEOUT=45

# Groq — primary
GROQ_API_KEY=replace_me
GROQ_MODEL=openai/gpt-oss-120b

# Gemini — fallback 1
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.6-flash

# OpenRouter — fallback 2
OPENROUTER_API_KEY=replace_me
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_APP_NAME=PM Agent
# OPENROUTER_SITE_URL=https://your-site.example

# AI-first reasoning context budget
# The LLM sees a lightweight whole-board view plus richer facts for selected
# delivery-relevant issues. Deterministic scores are advisory hints only.
AI_CONTEXT_MAX_CHARS=16000
AI_CONTEXT_MAX_ISSUES=24
AI_CONTEXT_BOARD_MAX_ISSUES=100
AI_CONTEXT_MAX_HOTSPOTS=10
AI_CONTEXT_MAX_CLUSTERS=6
AI_CONTEXT_MAX_DELTAS=12
AI_CONTEXT_MAX_ESCALATIONS=8

# Report language / timezone
# REPORT_LANGUAGE=vi -> Vietnamese
# REPORT_LANGUAGE=en -> English
REPORT_LANGUAGE=vi
REPORT_TIMEZONE=Asia/Ho_Chi_Minh

# Telegram
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHAT_ID=replace_me
TELEGRAM_SAFE_CHAR_LIMIT=3800
# Currently disabled in main.py to avoid a second Telegram document message.
TELEGRAM_ATTACH_DAILY_REPORT=false

# Storage / retention
SNAPSHOT_DIRECTORY=data/snapshots
SNAPSHOT_RETENTION=30
RUN_LOG_DIRECTORY=data/logs
RUN_LOG_RETENTION=14
DAILY_REPORT_DIRECTORY=data/daily_reports
DAILY_REPORT_RETENTION=14

# Analysis
NO_PROGRESS_DAYS=3
HOTSPOT_MIN_SCORE=3
HOTSPOT_MAX_ITEMS=8
DAILY_REPORT_MAX_RISKS=5
DAILY_REPORT_MAX_ACTIONS=4
DAILY_REPORT_MAX_OBSERVATIONS=2
DAILY_REPORT_CHANGE_DETAIL_LIMIT=5
DAILY_REPORT_BURST_THRESHOLD=20
DETAILED_REPORT_CHANGE_LIMIT=12
DETAILED_REPORT_CLUSTER_LIMIT=6

# Risk lifecycle / escalation policy
RISK_BLOCKER_ESCALATION_DAYS=1
RISK_OVERDUE_ESCALATION_DAYS=3
RISK_DEPENDENCY_ESCALATION_COUNT=3
RISK_CRITICAL_PRESSURE_SCORE=8
RISK_ACTION_PRESSURE_SCORE=4

# Optional test sprint helper
JIRA_TEST_SPRINT_NAME=PM Agent Test Sprint 1
JIRA_TEST_SPRINT_ISSUES=35
JIRA_TEST_SPRINT_DAYS=14

# Resource Allocation
# Copy data/resources.example.json to data/resources.json and maintain team skills there.
RESOURCE_PROFILE_FILE=data/resources.json
# Interactive Telegram bot: python main.py bot

# PM Agent API mode
PM_AGENT_CORS_ORIGINS="http://localhost:3200"

# PM Agent API / Dashboard
PM_TIMEZONE="Asia/Ho_Chi_Minh"
PM_AGENT_CACHE_SECONDS="90"
REDMINE_TIMEOUT_SECONDS="15"
